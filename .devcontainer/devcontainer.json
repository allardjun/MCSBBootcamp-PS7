// Codespace (or local "Reopen in Container") setup: everything the README's QuickStart asks for by hand, done once when the container is created.
{
  "name": "MCSB Bootcamp PS7",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  // QuickStart steps 1 and 2.
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  // QuickStart step 4: build the .venv from uv.lock and register it as a kernel, so that "MCSB PS7" is already in the notebook's kernel picker the first time it is opened.
  "postCreateCommand": "uv sync && uv run python -m ipykernel install --user --name mcsb-ps7 --display-name 'MCSB PS7'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "quarto.quarto"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
